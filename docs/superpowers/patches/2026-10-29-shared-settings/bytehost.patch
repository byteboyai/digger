+    fn application_titles_follow_ui_locale_and_keep_neutral_fallback() {
+        use bytehost_apps::proto::{AppDisplayI18n, AppDisplayTitle, DisplayTitleScope};
+        let mut app = summary(ObservedState::Running, None);
+        assert_eq!(super::app_title(&app, "zh-CN"), "Demo");
+        app.display_i18n = Some(AppDisplayI18n {
+            default_locale: "en".into(),
+            supported_locales: vec!["en".into(), "zh-CN".into()],
+            titles: vec![AppDisplayTitle {
+                scope: DisplayTitleScope::Presentation,
+                key: "title".into(),
+                fallback: "Notes fallback".into(),
+                values: [
+                    ("en".into(), "Notes".into()),
+                    ("zh-CN".into(), "笔记".into()),
+                ]
+                .into(),
+            }],
+            ..Default::default()
+        });
+        assert_eq!(super::app_title(&app, "en"), "Notes");
+        assert_eq!(super::app_title(&app, "zh-CN"), "笔记");
+        app.display_i18n.as_mut().unwrap().titles.clear();
+        assert_eq!(super::app_title(&app, "zh-CN"), "Demo");
+    }
