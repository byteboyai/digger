+                    &SecretToken::new("SYNTHETIC-NEW"),
+                    Some(new),
+                ))
+                .unwrap()
+        });
+        release.send(()).unwrap();
+        assert!(old_thread.join().unwrap().1.is_complete());
+        assert!(new_thread.join().unwrap().1.is_complete());
